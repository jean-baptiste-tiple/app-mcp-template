# ============================================
# App
# ============================================
# URL publique du site. Lue par les redirections d'auth (emailRedirectTo,
# resetPasswordForEmail) et par les métadonnées SEO (metadataBase, sitemap, robots).
# Sans elle, les liens de confirmation d'email pointent vers "undefined/auth/callback".
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# Supabase (ajouter après activation du starter supabase-auth)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_PROJECT_ID=your-project-id

# ============================================
# Canal MCP (src/mcp/ — mode d'emploi : src/mcp/README.md)
# ============================================
# URL canonique du serveur MCP (RFC 9728 `resource`), donnée aux hosts Claude et ChatGPT.
# Sans elle : <NEXT_PUBLIC_SITE_URL>/api/mcp. En prod : https://<domaine>/api/mcp.
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
# Tant que l'auth est désactivée, /api/mcp répond 401 en production (garde-fou anonyme).
# =true le lève pour le smoke test local sur `next start` (scripts/smoke-mcp.mjs le pose seul).
# JAMAIS en production réelle.
# MCP_ALLOW_ANONYMOUS=true
# UNIQUEMENT si le transport est stateful (ADR) — sessions et flux SSE entre invocations serverless.
# REDIS_URL=rediss://…
