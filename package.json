{
  "name": "app-mcp-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev --turbopack",
    "build": "pnpm widgets:build && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit && tsc --noEmit -p widgets/tsconfig.json",
    "check:framework": "node scripts/check-framework.mjs",
    "audit:lh": "npx --yes @lhci/cli@0.15.x autorun",
    "verify": "pnpm check:framework && pnpm type-check && pnpm lint && pnpm test && node scripts/verify-receipt.mjs write",
    "verify:cached": "node scripts/verify-receipt.mjs check || pnpm verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "widgets:build": "node widgets/build.mjs",
    "mcp:inspect": "npx @modelcontextprotocol/inspector",
    "mcp:smoke": "node scripts/smoke-mcp.mjs",
    "db:types": "echo 'Configurer Supabase d abord — voir CLAUDE.md' && exit 1",
    "db:migrate": "echo 'Configurer Supabase d abord — voir CLAUDE.md' && exit 1",
    "db:push": "echo 'Configurer Supabase d abord — voir CLAUDE.md' && exit 1",
    "db:reset": "echo 'Configurer Supabase d abord — voir CLAUDE.md' && exit 1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "jose": "6.2.12",
    "lucide-react": "^1.7.0",
    "mcp-handler": "1.1.0",
    "motion": "^13.0.0",
    "next": "^15",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-config-next": "^15",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^26",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "7.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "^3"
  },
  "packageManager": "pnpm@12.4.1"
}
